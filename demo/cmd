status=$?

if [[ $status -ne 0 ]]; then
    echo "Error: apfel-plus failed (exit $status)" >&2
    exit $status
fi

# --code already strips fences and prose; normalize whitespace only
result=$(echo "$result" | sed 's/^[[:space:]]*//' | sed '/^$/d')

if $COPY; then
    echo "$result" | pbcopy
    echo -e "\033[90m(copied to clipboard)\033[0m"
fi

echo -e "\033[32m\$\033[0m $result"

if $EXECUTE; then
    echo ""
    read -r -p "Run this? [y/N] " confirm
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        eval "$result"
    fi
fi
